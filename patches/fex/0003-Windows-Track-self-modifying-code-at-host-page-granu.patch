+    const uint64_t RegionEnd = std::min(Interval.End, reinterpret_cast<uint64_t>(Info.BaseAddress) + Info.RegionSize);
+    if (Info.State == MEM_COMMIT && ProtIsWritable(Info.Protect)) {
+      while (Address < RegionEnd) {
+        const auto Query = RWXIntervals.Query(Address);
+        if (!Query.Enclosed) {
+          return true;
+        }
+        Address += Query.Size;
+      }
+    }
+    Address = RegionEnd;
+  }
+  return false;
+}
