+++ b/Source/Windows/Common/InvalidationTracker.h
@@ -47,6 +47,10 @@ public:
   // NOTE: CodeInvalidationMutex must be locked when calling this, and if true is returned, kept locked until the write ends.
   bool BeginUntrackedWriteLocked(uint64_t Address, uint64_t Size);
 
+  // Untraps the host pages a write that can't be handled when faulting, such as a file read, would otherwise fault on only
+  // because they are shared with compiled code, switching them to full SMC detection.
+  void PrepareUntrackedWrite(uint64_t Address, uint64_t Size);
+
   FEXCore::HLE::ExecutableRangeInfo QueryExecutableRange(uint64_t Address);
 
 private:
@@ -61,6 +65,9 @@ private:
   // The range is extended to whole host pages.
   bool ProtectRWXIntervalsInternal(uint64_t Address, uint64_t Size, bool ForWriteLocked);
 
+  // Invalidates and untraps the host page, switching it to full SMC detection if requested.
+  void UntrapHostPage(FEXCore::IntervalList<uint64_t>::Interval HostInterval, bool FullSMCDetection);
+
   // Untraps (restoring write) or traps (removing write) the RWX intervals within [Address, End).
   // NOTE: Must be called with IntervalsLock held.
   void SetRWXIntervalsProtection(uint64_t Address, uint64_t End, bool Untrap);
